,"No aplica"],"targets":[{"page":0,"x":363.32,"y":140.06,"w":38.67,"h":11.87},{"page":0,"x":403.99,"y":140.06,"w":38.68,"h":11.87},{"page":0,"x":444.67,"y":140.06,"w":45.22,"h":11.87},{"page":0,"x":491.89,"y":140.06,"w":60.55,"h":11.87}],"id":"p0-f10","section":"PDA"},{"label":"No deben existir cerámicas o azulejos próximos (mínimo 1 metro de distancia) al área de instalación de las PDA, PFAP y PCL.","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":152.93,"w":38.67,"h":11.87},{"page":0,"x":403.99,"y":152.93,"w":38.68,"h":11.87},{"page":0,"x":444.67,"y":152.93,"w":45.22,"h":11.87},{"page":0,"x":491.89,"y":152.93,"w":60.55,"h":11.87}],"id":"p0-f13","section":"PDA"},{"label":"Toda el área de andén debe estar limpia y libre de obstáculos. Verificación de medidas","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":165.8,"w":38.67,"h":11.87},{"page":0,"x":403.99,"y":165.8,"w":38.68,"h":11.87},{"page":0,"x":444.67,"y":165.8,"w":45.22,"h":11.87},{"page":0,"x":491.89,"y":165.8,"w":60.55,"h":11.87}],"id":"p0-f16","section":"PDA"},{"label":"Verificación de medidas Se deben de confirmar las siguientes medidas en cada una de las columnas estructurales que estarán en frente del sistema PDA (Columna C-02 a C-10). Medidas a confirmar según figura: Valor A: 350±5 mm Valor B: 154 mm ≥ Valor C: 264 mm ≥ Valor D: 100±5 mm Valor E: 257±10 mm Valor F: 2860±30 mm Medidas de referencia: Xd0: 1836mm (desde el centro de vía) Z0: 170mm (desde superficie de vía)","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":191.41,"w":38.67,"h":110.56},{"page":0,"x":403.99,"y":191.41,"w":38.68,"h":110.56},{"page":0,"x":444.67,"y":191.41,"w":45.22,"h":110.56},{"page":0,"x":491.89,"y":191.41,"w":60.55,"h":110.56}],"id":"p0-f19","section":"PDA"},{"label":"Medidas a confirmar en columna C-02 hasta columna C-10 (plataforma 01 y 02): Valor A: 350±5 mm Valor B: ≥154 mm Valor C: ≥264 mm Valor D: 100±5 mm Valor E: 257±10 mm Valor F: 2860±30 mm","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":302.97,"w":38.67,"h":45.8},{"page":0,"x":403.99,"y":302.97,"w":38.68,"h":45.8},{"page":0,"x":444.67,"y":302.97,"w":45.22,"h":45.8},{"page":0,"x":491.89,"y":302.97,"w":60.55,"h":45.8}],"id":"p0-f22","section":"PDA"},{"label":"Ambas plataformas o bordes para la instalación del sistema PDA deben tener una longitud mínima de 48,580mm (tomando como referencia el punto central del área de embarque; la medida del centro al lado izquierdo debe ser 24,290mm y la medida de centro al lado derecho debe ser 24,290mm).","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":349.76,"w":38.67,"h":13.92},{"page":0,"x":403.99,"y":349.76,"w":38.68,"h":13.92},{"page":0,"x":444.67,"y":349.76,"w":45.22,"h":13.92},{"page":0,"x":491.89,"y":349.76,"w":60.55,"h":13.92}],"id":"p0-f25","section":"PDA"},{"label":"La altura de la viga superior sobre las PDA debe ser 2650±30mm sin considerar el piso acabado (considerando el piso acabado debe ser 2600±30mm). Esta altura se debe de medir desde el nivel de piso de andén hasta la cara inferior de la viga. Esta altura se debe de medir en las columnas estructurales de ambas plataformas (Confirmar en columna C-02 hasta columna C-10) (plataforma 01y 02).","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":364.68,"w":38.67,"h":21.52},{"page":0,"x":403.99,"y":364.68,"w":38.68,"h":21.52},{"page":0,"x":444.67,"y":364.68,"w":45.22,"h":21.52},{"page":0,"x":491.89,"y":364.68,"w":60.55,"h":21.52}],"id":"p0-f28","section":"PDA"},{"label":"Debe de existir una separación de 914±5mm entre las columnas destinadas para las instalación de las PFAP-01, 02, 03 y 04 (Esta separación se debe de validar en la parte inferior, intermedia y superior de las columnas).","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":387.2,"w":38.67,"h":11.86},{"page":0,"x":403.99,"y":387.2,"w":38.68,"h":11.86},{"page":0,"x":444.67,"y":387.2,"w":45.22,"h":11.86},{"page":0,"x":491.89,"y":387.2,"w":60.55,"h":11.86}],"id":"p0-f31","section":"PDA"},{"label":"La altura de la viga superior sobre las PFAP debe ser 2650±30mm sin considerar el piso acabado (considerando el piso acabado debe ser 2600±30mm). Esta altura se debe de medir desde el nivel de piso de andén hasta la cara inferior de la viga. Esta altura se debe de medir del lado izquierdo y derecho de las columnas destinadas para la instalación de la PFAP-01, 02, 03 y 04.","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":400.07,"w":38.67,"h":21.52},{"page":0,"x":403.99,"y":400.07,"w":38.68,"h":21.52},{"page":0,"x":444.67,"y":400.07,"w":45.22,"h":21.52},{"page":0,"x":491.89,"y":400.07,"w":60.55,"h":21.52}],"id":"p0-f34","section":"PDA"},{"label":"Debe existir una diferencia de 0±50mm entre el punto central o PK central del área de embarque y el centro de la columna estructural C-06 (plataforma 01 y 02).","type":"choice","required":true,"options":["Conforme","Conforme con reservas","No conforme","No aplica"],"targets":[{"page":0,"x":363.32,"y":422.58,"w":38.67,"h":11.87},{"page":0,"x":403.99,"y":422.58,"w":38.68,"h":11.87},{"page":0,"x":444.67,"y":422.58,"w":45.22,"h":11.87},{"page":0,"x":491.89,"y":422.58,"w":60.55,"h":11.87}],"id":"p0-f37","section":"PDA"},{"label":"Debe existir una distancia de 23,731±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-02 (plat
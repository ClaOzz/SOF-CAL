"p0-f4","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Mecánico: instalado según la secuencia del producto; par aprobado aplicado con llave calibrada y valor medido registrado (sin apriete por estimación).","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":245.52,"w":22.71,"h":23.64},{"page":0,"x":527.91,"y":245.52,"w":22.71,"h":23.64},{"page":0,"x":552.62,"y":245.52,"w":22.87,"h":23.64}],"id":"p0-f5","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Los materiales estan conforme a certificados y especificación aprobada.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":270.16,"w":20.07,"h":23.64},{"page":0,"x":236.87,"y":270.16,"w":20.07,"h":23.64},{"page":0,"x":258.94,"y":270.16,"w":20.07,"h":23.64}],"id":"p0-f6","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Placa con apoyo, nivelación o grout especificados (sin calzos improvisados); aplome verificado y apriete final conforme al sistema.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":270.16,"w":22.71,"h":23.64},{"page":0,"x":527.91,"y":270.16,"w":22.71,"h":23.64},{"page":0,"x":552.62,"y":270.16,"w":22.87,"h":23.64}],"id":"p0-f7","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Tornillería, anclajes, material de aporte, selladores y elementos de nivelación compatibles y aprobados","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":294.8,"w":20.07,"h":23.64},{"page":0,"x":236.87,"y":294.8,"w":20.07,"h":23.64},{"page":0,"x":258.94,"y":294.8,"w":20.07,"h":23.64}],"id":"p0-f8","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Distancia a bordes y separación entre anclajes conforme a ficha; sin agujeros desplazados o agrandados, varillas dobladas ni defectos rellenados por iniciativa.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":294.8,"w":22.71,"h":23.64},{"page":0,"x":527.91,"y":294.8,"w":22.71,"h":23.64},{"page":0,"x":552.62,"y":294.8,"w":22.87,"h":23.64}],"id":"p0-f9","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Tipo, espesor útil y resistencia documentada del soporte confirmados; baldosa, mortero o revestimiento no considerados soporte resistente.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":319.44,"w":20.07,"h":23.64},{"page":0,"x":236.87,"y":319.44,"w":20.07,"h":23.64},{"page":0,"x":258.94,"y":319.44,"w":20.07,"h":23.64}],"id":"p0-f10","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Pasamanos, elementos intermedios, codos, terminales y soportes montados según plano, con las juntas y holguras previstas.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":319.44,"w":22.71,"h":23.64},{"page":0,"x":527.91,"y":319.44,"w":22.71,"h":23.64},{"page":0,"x":552.62,"y":319.44,"w":22.87,"h":23.64}],"id":"p0-f11","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Estado del soporte e interferencias revisados (juntas, fisuras, desprendimientos, instalaciones, armaduras, tendones); sin cortar ni perforar refuerzos sin autorización técnica.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":344.08,"w":20.07,"h":23.64},{"page":0,"x":236.87,"y":344.08,"w":20.07,"h":23.64},{"page":0,"x":258.94,"y":344.08,"w":20.07,"h":23.64}],"id":"p0-f12","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Soportes a pared fijados sobre elemento resistente con su detalle específico; sin soldar componentes diseñados para unión mecánica sin autorización.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":344.08,"w":22.71,"h":23.64},{"page":0,"x":527.91,"y":344.08,"w":22.71,"h":23.64},{"page":0,"x":552.62,"y":344.08,"w":22.87,"h":23.64}],"id":"p0-f13","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Ejes y cotas marcados desde referencias de obra; pendientes, bordes, peldaños, interferencias, accesibilidad y continuidad de pasamanos verificados.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":368.71,"w":20.07,"h":23.64},{"page":0,"x":236.87,"y":368.71,"w":20.07,"h":23.64},{"page":0,"x":258.94,"y":368.71,"w":20.07,"h":23.64}],"id":"p0-f14","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Soldadura: procedimiento aprobado, personal cualificado, aporte y protección gaseosa compatibles; deformaciones controladas e inspección definida realizada.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":368.71,"w":22.71,"h":23.64},{"page":0,"x":527.91,"y":368.71,"w":22.71,"h":23.64},{"page":0,"x":552.62,"y":368.71,"w":22.87,"h":23.64}],"id":"p0-f15","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Tramo inicial presentado con conformidad de geometría y acabado; replanteo registrado por estación y tramo.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":393.35,"w":20.07,"h":16.88},{"page":0,"x":236.87,"y":393.35,"w":20.07,"h":16.88},{"page":0,"x":258.94,"y":393.35,"w":20.07,"h":16.88}],"id":"p0-f16","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Desbaste sin reducir soldaduras ni espesor resistente; residuos y coloración térmica retirados con tratamiento aprobado.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":393.35,"w":22.71,"h":16.88},{"page":0,"x":527.91,"y":393.35,"w":22.71,"h":16.88},{"page":0,"x":552.62,"y":393.35,"w":22.87,"h":16.88}],"id":"p0-f17","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Medidas reales verificadas contra planos; tramos identificados, cortes sin rebabas, superficies protegidas; piezas presentadas sin forzar.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":411.23,"w":20.07,"h":23.64},{"page":0,"x":236.87,"y":411.23,"w":20.07,"h":23.64},{"page":0,"x":258.94,"y":411.23,"w":20.07,"h":23.64}],"id":"p0-f18","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Decapado o pasivado (si aplica) solo por personal capacitado y con controles químicos; sin contaminación ferrosa.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":411.23,"w":22.71,"h":23.64},{"page":0,"x":527.91,"y":411.23,"w":22.71,"h":23.64},{"page":0,"x":552.62,"y":411.23,"w":22.87,"h":23.64}],"id":"p0-f19","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Alturas, alineación, aplome y pendiente comprobados en presentación, con sujeción temporal estable, según plano.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":435.87,"w":20.07,"h":24.83},{"page":0,"x":236.87,"y":435.87,"w":20.07,"h":24.83},{"page":0,"x":258.94,"y":435.87,"w":20.07,"h":24.83}],"id":"p0-f20","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Acabado uniforme equivalente a la muestra aceptada; conjunto limpio y protegido de trabajos posteriores; delimitación mantenida hasta la aceptación final.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":503.2,"y":435.87,"w":22.71,"h":24.83},{"page":0,"x":527.91,"y":435.87,"w":22.71,"h":24.83},{"page":0,"x":552.62,"y":435.87,"w":22.87,"h":24.83}],"id":"p0-f21","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Perforación con plantilla: diámetro, profundidad, equipo y método autorizados, medidos y registrados; agujeros fuera de especificación rechazados.","type":"choice","required":true,"options":["C","NC","N/A"],"targets":[{"page":0,"x":214.8,"y":461.7,"w":20.07,"h":23.64},{"page":0,"x":236.87,"y":461.7,"w":20.07,"h":23.64},{"page":0,"x":258.94,"y":461.7,"w":20.07,"h":23.64}],"id":"p0-f22","section":"3. DOCUMENTACIÓN, MATERIALES Y EQUIPOS"},{"label":"Uniones completas conform
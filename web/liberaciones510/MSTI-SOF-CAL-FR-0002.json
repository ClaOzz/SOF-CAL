{"version":510,"code":"MSTI-SOF-CAL-FR-0002","source":"MSTI-SOF-CAL-FR-0002 Liberación de ambientes Cuartos Técnicos V0(1).xlsx","pages":[{"page":0,"title":"Hoja 1","sections":["Datos del documento","PDA"]},{"page":1,"title":"Hoja 2","sections":["Datos del documento","CONEXOS"]}],"referencePages":[],"fields":[{"label":"Estación:","type":"text","target":{"page":0,"x":59.29,"y":71.87,"w":116.1,"h":8.26},"id":"p0-f0","section":"Datos del documento","auto":"location"},{"label":"Fecha:","type":"date","target":{"page":0,"x":206.92,"y":71.87,"w":57.04,"h":8.26},"id":"p0-f1","section":"Datos del documento","auto":"date"},{"label":"Documentos referenciales:","type":"text","target":{"page":0,"x":312.4,"y":71.87,"w":157.24,"h":16.87},"id":"p0-f2","section":"Datos del documento"},{"label":"Plano:","type":"text","target":{"page":0,"x":59.29,"y":81.13,"w":116.1,"h":7.61},"id":"p0-f3","section":"Datos del documento"},{"label":"Versión:","type":"text","target":{"page":0,"x":206.92,"y":81.13,"w":57.04,"h":7.61},"id":"p0-f4","section":"Datos del documento"},{"label":"Debe estar identificado el punto central o punto kilométrico georreferenciado (PK) que indique el centro del área de embarque en ambas plataformas de la estación.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":111.64,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":111.64,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":111.64,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":111.64,"w":27.54,"h":13.7}],"id":"p0-f5","section":"PDA"},{"label":"Deben estar identificados los puntos que indique el nivel de piso acabado en estación.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":126.34,"w":27.52,"h":13.71},{"page":0,"x":384.06,"y":126.34,"w":27.53,"h":13.71},{"page":0,"x":413.59,"y":126.34,"w":27.52,"h":13.71},{"page":0,"x":443.11,"y":126.34,"w":27.54,"h":13.71}],"id":"p0-f6","section":"PDA"},{"label":"Las plataformas para la instalación del sistema Puertas de Andén (PDA) deben tener una superficie pulida y nivelada.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":141.04,"w":27.52,"h":11.21},{"page":0,"x":384.06,"y":141.04,"w":27.53,"h":11.21},{"page":0,"x":413.59,"y":141.04,"w":27.52,"h":11.21},{"page":0,"x":443.11,"y":141.04,"w":27.54,"h":11.21}],"id":"p0-f7","section":"PDA"},{"label":"El piso para la instalación de las Puertas de Fin de Andén o Plataforma (PFAP) deben tener una superficie pulida y nivelada.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":153.25,"w":27.52,"h":9.26},{"page":0,"x":384.06,"y":153.25,"w":27.53,"h":9.26},{"page":0,"x":413.59,"y":153.25,"w":27.52,"h":9.26},{"page":0,"x":443.11,"y":153.25,"w":27.54,"h":9.26}],"id":"p0-f8","section":"PDA"},{"label":"No deben existir cerámicas o azulejos próximos (mínimo 1 metro de distancia) al área de instalación de las Puertas de Andén (PDA), Puertas de Fin de Andén o Plataforma (PFAP) y Paneles de Control Local (PCL).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":163.51,"w":27.52,"h":13.71},{"page":0,"x":384.06,"y":163.51,"w":27.53,"h":13.71},{"page":0,"x":413.59,"y":163.51,"w":27.52,"h":13.71},{"page":0,"x":443.11,"y":163.51,"w":27.54,"h":13.71}],"id":"p0-f9","section":"PDA"},{"label":"Toda el área de andén debe estar limpia y libre de obstáculos. Verificación de medidas","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":178.21,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":178.21,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":178.21,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":178.21,"w":27.54,"h":13.7}],"id":"p0-f10","section":"PDA"},{"label":"Verificación de medidas Se deben de confirmar las siguientes medidas en cada una de las columnas estructurales que estarán en frente del sistema PDA (Columna C-02 a C-10). Mediciones a verificar según figura adjunta: Valor A: 350 ± 5 mm (Ancho de plataforma). Valor B: 154 mm (Distancia desde Xd0 al borde del andén). ≥ Valor C: 264 mm (Distancia desde Xd0 a la cara de la columna). ≥ Valor E: 257 ± 10 mm (Profundidad de la plataforma). Punto de referencia: Xd0= 1835 +/-1mm (desde el centro de vía a centro de plataforma).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":192.92,"w":27.52,"h":127.75},{"page":0,"x":384.06,"y":192.92,"w":27.53,"h":127.75},{"page":0,"x":413.59,"y":192.92,"w":27.52,"h":127.75},{"page":0,"x":443.11,"y":192.92,"w":27.54,"h":127.75}],"id":"p0-f11","section":"PDA"},{"label":"Medidas a confirmar en columna C-02 hasta columna C-10 (plataforma 01 y 02): Valor A: 350±5 mm Valor B: ≥154 mm Valor C: ≥264 mm Valor E: 257±10 mm","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":321.67,"w":27.52,"h":32.85},{"page":0,"x":384.06,"y":321.67,"w":27.53,"h":32.85},{"page":0,"x":413.59,"y":321.67,"w":27.52,"h":32.85},{"page":0,"x":443.11,"y":321.67,"w":27.54,"h":32.85}],"id":"p0-f12","section":"PDA"},{"label":"Se debe garantizar que el valor C (distancia desde el punto Xd0 hasta la cara de la columna) sea igual o mayor a 264 mm en toda la verticalidad de las diferentes columnas (Confirmar en columna C-02 hasta columna C-10) (plataforma 01y 02).). Esta condición debe cumplirse considerando una tolerancia máxima de desviación de las columnas de ±5 mm.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":355.52,"w":27.52,"h":18.98},{"page":0,"x":384.06,"y":355.52,"w":27.53,"h":18.98},{"page":0,"x":413.59,"y":355.52,"w":27.52,"h":18.98},{"page":0,"x":443.11,"y":355.52,"w":27.54,"h":18.98}],"id":"p0-f13","section":"PDA"},{"label":"Ambas plataformas o bordes para la instalación del sistema PDA deben tener una longitud mínima de 48,580mm (tomando como referencia el punto central del área de embarque; la medida del centro al lado izquierdo debe ser 24,290mm y la medida de centro al lado derecho debe ser 24,290mm).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":375.5,"w":27.52,"h":17.03},{"page":0,"x":384.06,"y":375.5,"w":27.53,"h":17.03},{"page":0,"x":413.59,"y":375.5,"w":27.52,"h":17.03},{"page":0,"x":443.11,"y":375.5,"w":27.54,"h":17.03}],"id":"p0-f14","section":"PDA"},{"label":"La altura de la viga superior sobre las PDA debe ser 2650±30mm sin considerar el piso acabado (considerando el piso acabado debe ser 2600±30mm). Esta altura se debe de medir desde el nivel de piso de andén hasta la cara inferior de la viga. Esta altura se debe de medir en las columnas estructurales de ambas plataformas (Confirmar en columna C-02 hasta columna C-10) (plataforma 01y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":393.53,"w":27.52,"h":23.69},{"page":0,"x":384.06,"y":393.53,"w":27.53,"h":23.69},{"page":0,"x":413.59,"y":393.53,"w":27.52,"h":23.69},{"page":0,"x":443.11,"y":393.53,"w":27.54,"h":23.69}],"id":"p0-f15","section":"PDA"},{"label":"Debe de existir una separación de 914±5mm entre las columnas destinadas para las instalación de las Puertas de Fin de Andén o Plataforma (PFAP-01, 02, 03 y 04) (Esta separación se debe de validar en la parte inferior, intermedia y superior de las columnas).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":418.22,"w":27.52,"h":13.97},{"page":0,"x":384.06,"y":418.22,"w":27.53,"h":13.97},{"page":0,"x":413.59,"y":418.22,"w":27.52,"h":13.97},{"page":0,"x":443.11,"y":418.22,"w":27.54,"h":13.97}],"id":"p0-f16","section":"PDA"},{"label":"La altura de la viga superior sobre las Puertas de Fin de Andén o Plataforma (PFAP) debe ser 2650±30mm sin considerar el piso acabado (considerando el piso acabado debe ser 2600±30mm). Esta altura se debe de medir desde el nivel de piso de andén hasta la cara inferior de la viga. Esta altura se debe de medir del lado izquierdo y derecho de las columnas destinadas para la instalación de las PFAP-01, 02, 03 y 04.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":433.19,"w":27.52,"h":30.63},{"page":0,"x":384.06,"y":433.19,"w":27.53,"h":30.63},{"page":0,"x":413.59,"y":433.19,"w":27.52,"h":30.63},{"page":0,"x":443.11,"y":433.19,"w":27.54,"h":30.63}],"id":"p0-f17","section":"PDA"},{"label":"Debe existir una diferencia de 0±50mm entre el punto central o PK central del área de embarque y el centro de la columna estructural C-06 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":464.82,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":464.82,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":464.82,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":464.82,"w":27.54,"h":13.7}],"id":"p0-f18","section":"PDA"},{"label":"Debe existir una distancia de 23,731±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-02 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":479.53,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":479.53,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":479.53,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":479.53,"w":27.54,"h":13.7}],"id":"p0-f19","section":"PDA"},{"label":"Debe existir una distancia de 17,770±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-03 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":494.23,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":494.23,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":494.23,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":494.23,"w":27.54,"h":13.7}],"id":"p0-f20","section":"PDA"},{"label":"Debe existir una distancia de 11,847±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-04 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":508.94,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":508.94,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":508.94,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":508.94,"w":27.54,"h":13.7}],"id":"p0-f21","section":"PDA"},{"label":"Debe existir una distancia de 5,920±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-05 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":523.64,"w":27.52,"h":13.71},{"page":0,"x":384.06,"y":523.64,"w":27.53,"h":13.71},{"page":0,"x":413.59,"y":523.64,"w":27.52,"h":13.71},{"page":0,"x":443.11,"y":523.64,"w":27.54,"h":13.71}],"id":"p0-f22","section":"PDA"},{"label":"Debe existir una distancia de 5,922±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-07 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":538.35,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":538.35,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":538.35,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":538.35,"w":27.54,"h":13.7}],"id":"p0-f23","section":"PDA"},{"label":"Debe existir una distancia de 11,843±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-08 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":553.05,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":553.05,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":553.05,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":553.05,"w":27.54,"h":13.7}],"id":"p0-f24","section":"PDA"},{"label":"Debe existir una distancia de 17,766±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-09 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":567.75,"w":27.52,"h":13.7},{"page":0,"x":384.06,"y":567.75,"w":27.53,"h":13.7},{"page":0,"x":413.59,"y":567.75,"w":27.52,"h":13.7},{"page":0,"x":443.11,"y":567.75,"w":27.54,"h":13.7}],"id":"p0-f25","section":"PDA"},{"label":"Debe existir una distancia de 23,699±50mm desde el punto central o PK central del área de embarque hasta el centro de la columna estructural C-10 (plataforma 01 y 02).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":0,"x":354.54,"y":582.46,"w":27.52,"h":14.68},{"page":0,"x":384.06,"y":582.46,"w":27.53,"h":14.68},{"page":0,"x":413.59,"y":582.46,"w":27.52,"h":14.68},{"page":0,"x":443.11,"y":582.46,"w":27.54,"h":14.68}],"id":"p0-f26","section":"PDA"},{"label":"Estación:","type":"text","target":{"page":1,"x":61.48,"y":189.06,"w":165.56,"h":10.84},"id":"p1-f27","section":"Datos del documento","auto":"location"},{"label":"Fecha:","type":"date","target":{"page":1,"x":270.73,"y":189.06,"w":56.28,"h":10.84},"id":"p1-f28","section":"Datos del documento","auto":"date"},{"label":"Documentos referenciales:","type":"text","target":{"page":1,"x":375.44,"y":189.06,"w":186.78,"h":22.22},"id":"p1-f29","section":"Datos del documento"},{"label":"Plano:","type":"text","target":{"page":1,"x":61.48,"y":200.9,"w":165.56,"h":10.38},"id":"p1-f30","section":"Datos del documento"},{"label":"Versión:","type":"text","target":{"page":1,"x":270.73,"y":200.9,"w":56.28,"h":10.38},"id":"p1-f31","section":"Datos del documento"},{"label":"Los cuartos técnicos cumple con las dimensiones establecidas en los planos (se debe respetar el espacio libre en frente de los armarios).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":228.07,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":228.07,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":228.07,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":228.07,"w":27.54,"h":14.26}],"id":"p1-f32","section":"CONEXOS"},{"label":"El piso dentro de los cuartos técnicos debe estar terminado, nivelado y contar con la resistencia adecuada para soportar el peso de los equipos.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":243.32,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":243.32,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":243.32,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":243.32,"w":27.54,"h":14.26}],"id":"p1-f33","section":"CONEXOS"},{"label":"El piso técnico dentro los cuartos técnicos debe estar terminado, nivelado y contar con los huecos para el paso de cables.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":258.58,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":258.58,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":258.58,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":258.58,"w":27.54,"h":14.26}],"id":"p1-f34","section":"CONEXOS"},{"label":"Las paredes y techos deben estar libre de humedad y filtraciones.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":273.84,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":273.84,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":273.84,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":273.84,"w":27.54,"h":14.26}],"id":"p1-f35","section":"CONEXOS"},{"label":"Los cuartos técnicos debe contar con un acabado ignifugo (resistente al fuego).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":289.1,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":289.1,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":289.1,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":289.1,"w":27.54,"h":14.26}],"id":"p1-f36","section":"CONEXOS"},{"label":"Los cuartos técnicos debe contar con equipos de detección y extinción de incendios.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":304.36,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":304.36,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":304.36,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":304.36,"w":27.54,"h":14.26}],"id":"p1-f37","section":"CONEXOS"},{"label":"Los cuartos técnicos debe contar con puertas y con cerraduras que garanticen la seguridad.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":319.62,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":319.62,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":319.62,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":319.62,"w":27.54,"h":14.26}],"id":"p1-f38","section":"CONEXOS"},{"label":"Los cuartos técnicos debe contar con un sistema de puesta a tierra para aterrizar los armarios (<5 ohm o normativa local).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":334.88,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":334.88,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":334.88,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":334.88,"w":27.54,"h":14.26}],"id":"p1-f39","section":"CONEXOS"},{"label":"Los cuartos técnicos debe contar con un sistema de aire acondicionado operativo.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":350.15,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":350.15,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":350.15,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":350.15,"w":27.54,"h":14.26}],"id":"p1-f40","section":"CONEXOS"},{"label":"Los cuartos técnicos debe contar con alimentación eléctrica con respaldo (208VAC, 60Hz, Trifásico con neutro) (120VAC, 60Hz, 1 fase).","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":365.41,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":365.41,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":365.41,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":365.41,"w":27.54,"h":14.26}],"id":"p1-f41","section":"CONEXOS"},{"label":"Los disyuntores y tomas de corriente deben estar etiquetados.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":380.67,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":380.67,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":380.67,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":380.67,"w":27.54,"h":14.26}],"id":"p1-f42","section":"CONEXOS"},{"label":"Los cuartos técnicos debe contar con bandejas portacables que se comuniquen con los equipos periféricos de los sistemas.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":395.93,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":395.93,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":395.93,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":395.93,"w":27.54,"h":14.26}],"id":"p1-f43","section":"CONEXOS"},{"label":"Los cuartos técnicos debe contar con un sistema de iluminación operativo.","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":411.19,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":411.19,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":411.19,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":411.19,"w":27.54,"h":14.26}],"id":"p1-f44","section":"CONEXOS"},{"label":"¿ Los accesos al área o ( sala técnica ) están disponibles, limpios, terminados, libres de escombros y obstáculos para la instalación de los sistemas afectados?","type":"choice","required":true,"options":["A","ACR","NC","N/A"],"targets":[{"page":1,"x":447.09,"y":426.45,"w":27.52,"h":14.26},{"page":1,"x":476.62,"y":426.45,"w":27.52,"h":14.26},{"page":1,"x":506.14,"y":426.45,"w":27.52,"h":14.26},{"page":1,"x":535.67,"y":426.45,"w":27.54,"h":14.26}],"id":"p1-f45","section":"CONEXOS"},{"label":"¿Dimensión y disposición del área están acorde al plano de arquitectura de la estación?","type":"choice","requi
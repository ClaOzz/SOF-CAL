/** Run configurarSOFCAL once from the Apps Script editor as the owner. */
function configurarSOFCAL(){
 const props=PropertiesService.getScriptProperties(),email=prop_('ADMIN_EMAIL').trim().toLowerCase();if(!/@gmail\.com$/.test(email))throw Error('ADMIN_EMAIL debe ser su Gmail.');let id=props.getProperty('SPREADSHEET_ID');if(!id){const ss=SpreadsheetApp.create('SOF-CAL · Base de datos y Control');id=ss.getId();props.setProperty('SPREADSHEET_ID',id);}const ss=SpreadsheetApp.openById(id);ss.setSpreadsheetLocale('en_US');ss.setSpreadsheetTimeZone('America/Santo_Domingo');
 const schemas={Documentacion:['ID','Categoría','Título','Enlace','Proyecto','Contratista','Revisión','Observaciones'],Aprobaciones:['ID','UUID','Hash del contenido','Solicitante','Motivo','Fecha','Estado','Administrador','Fecha de aprobación','Consecutivo'],Registros:SOF_HEADERS,Usuarios:['Correo Gmail','Nombre','Perfil','Activo','Trigrama','Google sub'],Consecutivos:['Clave','Último usado','Actualizado'],_Reservas:['UUID','Consecutivo','Alcance','Google sub','Número','Creado'],Detalle_Campos:['UUID','Versión','Actividad','Campo','Valor'],Documentos:['UUID','Fecha','Nombre','SHA256','Enlace','Correo'],Configuracion:['Clave','JSON o archivo','Actualizado'],Auditoria:['Fecha','Correo','Acción','UUID','Consecutivo','Versión']};
 for(const [name,headers] of Object.entries(schemas)){let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);if(s.getLastRow()===0)s.getRange(1,1,1,headers.length).setValues([headers]);s.setFrozenRows(1);s.getRange(1,1,1,headers.length).setBackground('#001D61').setFontColor('#ffffff').setFontWeight('bold');s.setColumnWidths(1,headers.length,150);s.getDataRange().setFontFamily('Arial').setFontSize(10);if(!s.getFilter()&&s.getLastRow()>1)s.getRange(1,1,s.getMaxRows(),headers.length).createFilter();}
 if(!values_('Usuarios').some(r=>String(r[0]).toLowerCase()===email))append_('Usuarios',[[email,'Administrador','admin','Sí','','']]);const users=ss.getSheetByName('Usuarios');users.getRange('C2:C').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['admin','calidad','instalaciones'],true).setAllowInvalid(false).build());users.getRange('D2:D').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Sí','No'],true).setAllowInvalid(false).build());
 for(const [kind,name] of Object.entries(SOF_SECTIONS)){let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);s.getRange(1,1,1,SOF_HEADERS.length).setValues([SOF_HEADERS]).setBackground('#001D61').setFontColor('white').setFontWeight('bold');s.getRange('A2').setFormula('=IFERROR(FILTER(Registros!A2:V,Registros!B2:B="'+kind+'"),"")');s.setFrozenRows(1);s.setColumnWidths(1,22,145);s.getRange('D2:D').setNumberFormat('dd/mm/yyyy');s.getRange('L2:L').setNumberFormat('dd/mm/yyyy hh:mm');s.getRange('T2:T').setNumberFormat('dd/mm/yyyy');}
 for(const k of ['DATA_FOLDER_ID','DOCUMENT_FOLDER_ID'])if(!props.getProperty(k))props.setProperty(k,DriveApp.createFolder(k==='DATA_FOLDER_ID'?'SOF-CAL · Datos y versiones':'SOF-CAL · Documentos').getId());
 ss.getSheetByName('Registros').getRange('D2:D').setNumberFormat('dd/mm/yyyy');ss.getSheetByName('Registros').getRange('L2:L').setNumberFormat('dd/mm/yyyy hh:mm');ss.getSheetByName('Registros').getRange('T2:T').setNumberFormat('dd/mm/yyyy');ss.getSheetByName('Registros').getRange('U2:U').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Pendiente','En curso','Cerrado','No aplica'],true).setAllowInvalid(false).build());
 crearControl_();protegerSOFCAL_();const triggers=ScriptApp.getProjectTriggers();if(!triggers.some(t=>t.getHandlerFunction()==='registrarEdicionSOFCAL'))ScriptApp.newTrigger('registrarEdicionSOFCAL').forSpreadsheet(id).onEdit().create();SpreadsheetApp.flush();console.log('Base preparada: '+ss.getUrl());console.log('Complete las propiedades OAuth y publique la aplicación web.');
}
function crearControl_(){const ss=book_();let s=ss.getSheetByName('Control');if(!s)s=ss.insertSheet('Control',0);s.clear();s.getCharts().forEach(c=>s.removeChart(c));s.setHiddenGridlines(true);s.setFrozenRows(15);s.setColumnWidth(1,170);s.setColumnWidth(2,210);s.setColumnWidths(3,20,145);s.getRange('A1:V1').merge().setValue('SOF-CAL | Control de actividades').setBackground('#001D61').setFontColor('white').setFontSize(22).setFontWeight('bold');s.setRowHeight(1,50);s.getRange('A2:V2').merge().setValue('Filtra por actividad, responsable y fechas. Los registros provienen de las hojas de actividad; el seguimiento se modifica en Registros, columnas T–V.').setFontColor('#526580').setWrap(true);s.setRowHeight(2,42);s.getRange('A3:A7').setValues([['Actividad'],['Responsable'],['Estado'],['Desde'],['Hasta']]);s.getRange('B3:B5').setValues([['Todas'],['Todos'],['Todos']]);s.getRange('B6').setValue(new Date(new Date().getFullYear(),0,1));s.getRange('B7').setValue(new Date(new Date().getFullYear(),11,31));s.getRange('B6:B7').setNumberFormat('dd/mm/yyyy');s.getRange('B3:B7').setBackground('#e4f3fe').setFontColor('#001D61');s.getRange('B3').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Todas',...Object.keys(SOF_SECTIONS)],true).setAllowInvalid(false).build());s.getRange('B4').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInRange(ss.getSheetByName('Usuarios').getRange('B2:B'),true).setAllowInvalid(true).build());s.getRange('B5').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Todos','Borrador','Finalizada','Archivada','Anulada'],true).setAllowInvalid(false).build());
 s.getRange('D3:H3').merge().setValue('Consulta central').setFontSize(16).setFontColor('#001D61').setFontWeight('bold');s.getRange('D4:E8').setValues([['Total filtrado',''],['Finalizadas',''],['Pendientes de seguimiento',''],['Vencidas sin cierre',''],['Porcentaje finalizado','']]);s.getRange('F4').setFormula('=COUNTIF(A16:A,"<>")');s.getRange('F5').setFormula('=COUNTIF(J16:J,"Finalizada")');s.getRange('F6').setFormula('=COUNTIF(U16:U,"Pendiente")+COUNTIF(U16:U,"En curso")');s.getRange('F7').setFormula('=COUNTIFS(T16:T,">0",T16:T,"<"&TODAY(),U16:U,"<>Cerrado",U16:U,"<>No aplica")');s.getRange('F8').setFormula('=IFERROR(F5/F4,0)').setNumberFormat('0.0%');s.getRange('F4:F8').setFontSize(20).setFontWeight('bold').setFontColor('#0181C9');s.getRange('H4:I8').setValues([['OK',''],['NOK',''],['N/A',''],['PEND',''],['Sin responder','']]);for(let n=0;n<5;n++)s.getRange(n+4,9).setFormula('=SUM('+String.fromCharCode(79+n)+'16:'+String.fromCharCode(79+n)+')');s.getRange('K4:L5').setValues([['Esta semana',''],['Este mes','']]);s.getRange('L4').setFormula('=COUNTIFS(D16:D,">="&TODAY()-WEEKDAY(TODAY(),2)+1,D16:D,"<"&TODAY()-WEEKDAY(TODAY(),2)+8)');s.getRange('L5').setFormula('=COUNTIFS(D16:D,">="&EOMONTH(TODAY(),-1)+1,D16:D,"<="&EOMONTH(TODAY(),0))');s.getRange('A10:V10').merge().setValue('Dirección del libro: '+ss.getUrl()).setFontColor('#0181C9');s.getRange('A11:V11').merge().setValue('Usuarios: controla acceso y perfil por Gmail. Consecutivos: “Último usado”; FNC/FHC requieren inicialización oficial. Nunca reduzcas un contador.');s.getRange('A12:V12').merge().setValue('Las hojas de actividades son vistas de Registros. Detalle_Campos contiene los campos de cada versión. Los archivos de datos conservan respuestas, evidencias y firmas.');s.getRange('A13:V13').merge().setValue('La app actualiza al guardar y consulta cada 30 segundos mientras está visible. Un borrador sin conexión obtiene su consecutivo al volver a sincronizar.');s.getRange(15,1,1,SOF_HEADERS.length).setValues([SOF_HEADERS]).setBackground('#001D61').setFontColor('white').setFontWeight('bold');s.getRange('A16').setFormula('=IFERROR(FILTER(Registros!A2:V,Registros!A2:A<>"",IF(B3="Todas",Registros!A2:A<>"",Registros!B2:B=B3),IF(B4="Todos",Registros!A2:A<>"",Registros!H2:H=B4),IF(B5="Todos",Registros!A2:A<>"",Registros!J2:J=B5),Registros!D2:D>=B6,Registros!D2:D<=B7),"")');s.getRange('D16:D').setNumberFormat('dd/mm/yyyy');s.getRange('L16:L').setNumberFormat('dd/mm/yyyy hh:mm');s.getRange('T16:T').setNumberFormat('dd/mm/yyyy');s.getRange('A11:V13').setFontSize(10).setFontColor('#526580').setWrap(true);s.setRowHeights(11,3,30);s.getRange('H4:I8').setBackground('#edf4fa');s.insertChart(s.newChart().setChartType(Charts.ChartType.BAR).addRange(s.getRange('H4:I8')).setPosition(3,14,0,0).setOption('title','Resultados de inspección filtrados').setOption('legend',{position:'none'}).setOption('colors',['#0181C9']).setOption('width',600).setOption('height',230).build());
}
function protegerSOFCAL_(){const ss=book_(),me=Session.getEffectiveUser();for(const s of ss.getSheets()){let p=s.getProtections(SpreadsheetApp.ProtectionType.SHEET).find(x=>x.getDescription()==='SOF-CAL');if(!p)p=s.protect().setDescription('SOF-CAL');p.addEditor(me);const editors=p.getEditors().filter(x=>x.getEmail()!==me.getEmail());if(editors.length)p.removeEditors(editors);if(p.canDomainEdit())p.setDomainEdit(false);if(s.getName()==='Control')p.setUnprotectedRanges([s.getRange('B3:B7')]);else p.setUnprotectedRanges([]);} }
function registrarEdicionSOFCAL(e){if(!e?.range)return;const sheet=e.range.getSheet(),name=sheet.getName();if(name==='Registros'&&e.range.getRow()>1&&e.range.getColumn()>=20&&e.range.getLastColumn()<=22){const id=sheet.getRange(e.range.getRow(),1).getValue(),code=sheet.getRange(e.range.getRow(),3).getValue();append_('Auditoria',[[new Date(),e.user?.getEmail()||'Editor del libro','SEGUIMIENTO_EN_SHEET',id,code,'']]);} }

function readRecord_(row){const url=row.values[12],id=String(url).match(/\/d\/([^/]+)/)?.[1];if(!id)throw Error('Registro sin archivo de datos.');return JSON.parse(DriveApp.getFileById(id).getBlob().getDataAsString());}
function get_(u,id){const row=recordRow_(id);if(!row)throw Error('Registro no encontrado.');allowed_(u,row.values[1]);const r=readRecord_(row);r._cloudVersion=Number(row.values[10]);r._cloudOwner=row.values[8];r.tracking={due:row.values[19] instanceof Date?Utilities.formatDate(row.values[19],'America/Santo_Domingo','yyyy-MM-dd'):String(row.values[19]||''),status:row.values[20],notes:row.values[21]};return {record:r,version:r._cloudVersion};}

function doPost(e){try{if(!e.postData||e.postData.contents.length>24000000)throw Error('Solicitud vacía o demasiado grande.');const req=JSON.parse(e.postData.contents),u=session_(req.session);let data;switch(req.action){case'me':data={user:u,sheetURL:book_().getUrl(),sections:SOF_SECTIONS};break;case'logout':CacheService.getScriptCache().remove('session:'+hash_(req.session));data={};break;case'list':data=list_(u,req);break;case'get':data=get_(u,req.id);break;case'reserve':data=lock_(()=>reserve_(u,req));break;case'save':data=lock_(()=>save_(u,req));break;case'upload':data=lock_(()=>upload_(u,req));break;case'followup':data=lock_(()=>followup_(u,req));break;case'config':data=lock_(()=>config_(u,req));break;case'approval':data=lock_(()=>approval_(u,req));break;case'destination':data=lock_(()=>destination_(u,req));break;default:throw Error('Acción no admitida.');}return json_({ok:true,data,serverTime:new Date().toISOString()});}catch(err){return json_({ok:false,error:err.message});}}
function kind_(r){if(r.uuid&&r.datos)return r.sis==='MAT'?'materiales':'inspeccion';return r.kind==='nc'?r.type:r.kind;}
function meta_(r){const old=!!r.uuid&&!!r.datos;return {id:old?r.uuid:r.id,kind:kind_(r),code:old?r.consec:r.code,date:old?r.datos.fecha:r.date,project:String(old?r.datos.proyecto:r.project).match(/D\d{3}/)?.[0]||'',system:old?r.sis:r.system,location:old?[r.datos.estacion,r.datos.cuarto,r.datos.detalleUbicacion].filter(Boolean).join(' · '):r.location,responsible:old?r.inspectorNombre:r.responsible,state:old?r.estado:r.state};}
function iso_(s){const d=new Date(s+'T12:00:00Z');if(!Number.isFinite(+d)||d.toISOString().slice(0,10)!==s)throw Error('Fecha inválida.');d.setUTCDate(d.getUTCDate()+4-(d.getUTCDay()||7));const y=d.getUTCFullYear();return {year:y,week:Math.ceil((((d-new Date(Date.UTC(y,0,1,12)))/86400000)+1)/7)};}
function next_(key,initial){const s=book_().getSheetByName('Consecutivos'),rows=values_('Consecutivos'),idx=rows.findIndex(r=>r[0]===key);if(idx<0){if(initial===null)throw Error('Administración debe inicializar el contador oficial '+key+' en Consecutivos (último usado).');append_('Consecutivos',[[key,initial+1,new Date()]]);return initial+1;}const n=Number(rows[idx][1]);if(!Number.isSafeInteger(n)||n<0)throw Error('Contador central inválido.');s.getRange(idx+2,2,1,2).setValues([[n+1,new Date()]]);return n+1;}

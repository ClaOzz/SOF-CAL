function upload_(u,req){const row=recordRow_(req.id);if(!row)throw Error('Guarde primero el registro en el servidor.');allowed_(u,row.values[1]);if(row.values[8]!==u.email&&u.role!=='admin')throw Error('Solo el autor o administrador puede adjuntar documentos.');if(!/^[A-Za-z0-9+/=]+$/.test(req.base64||'')||req.base64.length>24000000)throw Error('Documento inválido o demasiado grande.');if(!['application/pdf','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'].includes(req.mime))throw Error('Tipo de documento no admitido.');if(row.values[1]==='liberacion')validateSignatures_(u,readRecord_(row));const digest=hash_(req.base64),prev=values_('Documentos').find(x=>x[0]===req.id&&x[3]===digest);if(prev)return {url:prev[4],duplicate:true};const root=DriveApp.getFolderById(prop_('DOCUMENT_FOLDER_ID')),child=(f,n)=>{const name=String(n||'General').replace(/[\x00-\x1f/\\]/g,'-'),a=f.getFoldersByName(name);return a.hasNext()?a.next():f.createFolder(name);};const inspector=child(root,row.values[7]),folder=child(child(inspector,SOF_SECTIONS[row.values[1]]),row.values[5]);const file=folder.createFile(Utilities.newBlob(Utilities.base64Decode(req.base64),req.mime,String(req.name).replace(/[\x00-\x1f/\\]/g,'-')));append_('Documentos',[[req.id,new Date(),req.name,digest,file.getUrl(),u.email]]);book_().getSheetByName('Registros').getRange(row.row,14).setValue(file.getUrl());return {url:file.getUrl()};}
function followup_(u,req){const row=recordRow_(req.id);if(!row)throw Error('Registro no encontrado.');allowed_(u,row.values[1]);if(u.role==='instalaciones'&&row.values[8]!==u.email)throw Error('Solo puede actualizar sus seguimientos.');if(!['Pendiente','En curso','Cerrado','No aplica'].includes(req.status))throw Error('Estado de seguimiento no válido.');if(req.due&&!/^\d{4}-\d{2}-\d{2}$/.test(req.due))throw Error('Fecha no válida.');book_().getSheetByName('Registros').getRange(row.row,20,1,3).setValues([[req.due?new Date(req.due+'T12:00:00-04:00'):'',req.status,safe_(String(req.notes||'').slice(0,10000))]]);append_('Auditoria',[[new Date(),u.email,'SEGUIMIENTO',req.id,row.values[2],row.values[10]]]);return {saved:true};}
function config_(u,req){const s=book_().getSheetByName('Configuracion'),rows=values_('Configuracion');if(req.write){if(u.role!=='admin')throw Error('Requiere Administrador.');for(const [key,value] of Object.entries(req.values||{})){if(!['links','catalog','inspectors','templates'].includes(key))throw Error('Configuración no permitida.');const str=JSON.stringify(value);if(str.length>22000000)throw Error('Configuración demasiado grande.');const f=DriveApp.getFolderById(prop_('DATA_FOLDER_ID')).createFile(Utilities.newBlob(str,'application/json','config-'+key+'-'+Date.now()+'.json'));const pointer=JSON.stringify({driveFile:f.getId()}),idx=rows.findIndex(r=>r[0]===key);if(idx<0)append_('Configuracion',[[key,pointer,new Date()]]);else s.getRange(idx+2,2,1,2).setValues([[pointer,new Date()]]);}if(req.values?.links)writeLinks_(req.values.links);return {saved:true};}return Object.fromEntries(rows.map(r=>{let v=JSON.parse(r[1]);if(v.driveFile)v=JSON.parse(DriveApp.getFileById(v.driveFile).getBlob().getDataAsString());return [r[0],v];}));}
function destination_(u,req){if(u.role!=='admin')throw Error('Requiere administrador.');const props=PropertiesService.getScriptProperties();if(!req.folder){const id=props.getProperty('ROOT_FOLDER_ID');return {id:id||'',url:id?'https://drive.google.com/drive/folders/'+id:'',name:id?DriveApp.getFolderById(id).getName():'Carpetas iniciales de SOF-CAL'};}const id=String(req.folder).match(/\/folders\/([A-Za-z0-9_-]+)/)?.[1]||String(req.folder).trim();if(!/^[A-Za-z0-9_-]{10,150}$/.test(id))throw Error('Pegue el enlace o ID de una carpeta de Google Drive.');const root=DriveApp.getFolderById(id),child=name=>{const it=root.getFoldersByName(name);return it.hasNext()?it.next():root.createFolder(name);};const data=child('SOF-CAL - Datos y versiones'),docs=child('SOF-CAL - Documentos');props.setProperties({ROOT_FOLDER_ID:id,DATA_FOLDER_ID:data.getId(),DOCUMENT_FOLDER_ID:docs.getId()});append_('Auditoria',[[new Date(),u.email,'CAMBIAR_CARPETA_DRIVE',id,root.getName(),'']]);return {id,url:root.getUrl(),name:root.getName()};}
function reconcileCounter_(r,m){let key,n,match;if(['inspeccion','materiales'].includes(m.kind)){match=m.code.match(/^INSP-CAL-(.+)-([A-ZÑ]{3})-(\d+)$/);if(!match)throw Error('Referencia histórica de inspección no reconocida.');key='INSP|'+match[1]+'|'+match[2];n=+match[3];}else if(['FNC','FHC'].includes(m.kind)){match=m.code.match(/^(FNC|FHC)-(D\d{3})-(\d+)-(\d{4})$/);if(!match)throw Error('Referencia documental no reconocida.');key=match[1]+'|'+match[2]+'|'+match[4];n=+match[3];}else {match=m.code.match(/(\d{2})(\d{2})-(\d+)$/);if(!match)throw Error('Consecutivo semanal histórico no reconocido.');key=[m.kind,m.kind==='liberacion'?'GLOBAL':m.project,m.system,2000+(+match[2]),+match[1]].join('|');n=+match[3];}const rows=values_('Consecutivos'),idx=rows.findIndex(r=>r[0]===key);if(idx<0)append_('Consecutivos',[[key,n,new Date()]]);else if(Number(rows[idx][1])<n)book_().getSheetByName('Consecutivos').getRange(idx+2,2,1,2).setValues([[n,new Date()]]);}

function stats_(r){const a={OK:0,NOK:0,'N/A':0,PEND:0,sin:0};if(!r.generales)return a;const answers=[...Object.values(r.generales),...Object.values(r.respuestas||{})];for(const x of answers){const k=x?.res||'sin';a[k]=(a[k]||0)+1;}const expected=(r.snapshot?.gens?.length||0)+(r.snapshot?.points?.length||0);a.sin+=Math.max(0,expected-answers.length);return a;}
function documentHash_(r){const c=JSON.parse(JSON.stringify(r));for(const k of Object.keys(c))if(k.startsWith('_cloud')||['_lastRequestId','tracking','updated','state','log','signatureException','checkedPages','exportedAt','_readOnly'].includes(k))delete c[k];c.participants=(c.participants||[]).map(p=>{delete p.signature;return p;});c.annotations=(c.annotations||[]).filter(a=>!a.signatureId);return hash_(JSON.stringify(c));}
function validateSignatures_(u,r){if(u.role==='instalaciones')return;const h=documentHash_(r),ps=(r.participants||[]).filter(p=>p.present);if(ps.length&&ps.every(p=>p.name&&p.signature?.hash===h))return;const a=values_('Aprobaciones').find(a=>a[1]===r.id&&a[2]===h&&a[6]==='Aprobada');if(!a)throw Error('FIRMAS: requiere firmas de los presentes o aprobación vigente del administrador.');}
function approval_(u,req){const rows=values_('Aprobaciones');if(req.mode==='list'){if(u.role!=='admin')throw Error('Requiere Administrador.');return rows.filter(r=>r[6]==='Pendiente').map(r=>({id:r[0],recordId:r[1],email:r[3],reason:r[4],code:r[9],date:r[5]}));}if(req.mode==='approve'){if(u.role!=='admin')throw Error('Requiere Administrador.');const n=rows.findIndex(r=>r[0]===req.approvalId);if(n<0)throw Error('Solicitud no encontrada.');const row=recordRow_(rows[n][1]);if(!row||documentHash_(readRecord_(row))!==rows[n][2])throw Error('El documento cambió. Solicite autorización de la versión actual.');book_().getSheetByName('Aprobaciones').getRange(n+2,7,1,3).setValues([['Aprobada',u.email,new Date()]]);return {approved:true};}const row=recordRow_(req.id);if(!row||row.values[1]!=='liberacion')throw Error('Guarde la liberación primero.');if(row.values[8]!==u.email&&u.role!=='admin')throw Error('Solo el autor puede solicitar la excepción.');const h=documentHash_(readRecord_(row)),found=rows.find(r=>r[1]===req.id&&r[2]===h&&r[6]==='Aprobada');if(found)return {approved:true,by:found[7],at:found[8],reason:found[4],hash:h};if(req.mode!=='request')return {approved:false};if(!String(req.reason||'').trim())throw Error('Indique el motivo.');const pending=rows.find(r=>r[1]===req.id&&r[2]===h&&r[6]==='Pendiente');if(!pending)append_('Aprobaciones',[[random_(),req.id,h,u.email,req.reason,new Date(),u.role==='admin'?'Aprobada':'Pendiente',u.role==='admin'?u.email:'',u.role==='admin'?new Date():'',row.values[2]]]);return {approved:u.role==='admin',by:u.email,at:new Date().toISOString(),reason:req.reason,hash:h};}

function growViews_(){const ss=book_(),needed=ss.getSheetByName('Registros').getLastRow()+20;for(const name of ['Control',...Object.values(SOF_SECTIONS)]){const s=ss.getSheetByName(name);if(s&&s.getMaxRows()<needed)s.insertRowsAfter(s.getMaxRows(),needed-s.getMaxRows());}}

function writeLinks_(links){const s=book_().getSheetByName('Documentacion');if(!s)return;if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,8).clearContent();append_('Documentacion',links.map(l=>[l.id,l.category,l.title,l.url,l.project||'',l.contractor||'',l.revision||'',l.notes||'']));}

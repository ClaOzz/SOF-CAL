 else {key=m.kind==='liberacion'?['liberacion','GLOBAL',m.system,w.year,w.week].join('|'):scope;n=next_(key,0);code=m.kind==='liberacion'?m.system+String(w.week).padStart(2,'0')+String(w.year).slice(-2)+'-'+String(n).padStart(3,'0'):m.kind.toUpperCase()+'-'+m.project+'-'+m.system+'-'+String(w.week).padStart(2,'0')+String(w.year).slice(-2)+'-'+String(n).padStart(3,'0');}

function user_(identity){const list=values_('Usuarios'),row=list.find(r=>String(r[0]).trim().toLowerCase()===identity.email.toLowerCase());if(!row||!['SI','SÍ','TRUE','1'].includes(String(row[3]).toUpperCase()))throw Error('ACCESO_DENEGADO: su correo no está autorizado o está desactivado.');if(!['admin','calidad','instalaciones'].includes(row[2]))throw Error('Perfil no válido en Usuarios.');if(row[5]&&String(row[5])!==identity.sub)throw Error('La cuenta Google no corresponde a la identidad registrada.');if(!row[5])lock_(()=>{const sh=book_().getSheetByName('Usuarios'),n=list.indexOf(row)+2;sh.getRange(n,6).setValue(identity.sub);});return {email:identity.email,sub:identity.sub,name:String(row[1]||identity.name||identity.email),role:String(row[2]),tri:String(row[4]||'').trim().toUpperCase()};}

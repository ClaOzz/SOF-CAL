 if(!req.confirmToken){const token=random_();cache.put('maintenance:'+token,JSON.stringify({by:u.email,mode,scope,fingerprint,expires:Date.now()+300000}),300);return {token,count,phrase,scope,mode};}
 const key='maintenance:'+req.confirmToken,raw=cache.get(key);if(!raw)throw Error('La confirmación venció. Revise de nuevo el alcance.');const saved=JSON.parse(raw);if(saved.by!==u.email||saved.mode!==mode||JSON.stringify(saved.scope)!==JSON.stringify(scope)||saved.fingerprint!==fingerprint||saved.expires<Date.now()||req.phrase!==phrase)throw Error('El alcance cambió o la confirmación no es válida. Revise nuevamente.');cache.remove(key);const stamp=new Date(),job=Utilities.getUuid();ensureSheet_('_Mantenimiento',['ID','Operación','Alcance JSON','Fecha','Estado']);let countDone=0,issues=[];
 if(mode==='records'){const s=book_().getSheetByName('Registros'),all=values_('Registros'),ids=new Set(rows.map(r=>r[0]));for(let n=0;n<all.length;n++)if(ids.has(all[n][0])){s.getRange(n+2,10,1,3).setValues([['Eliminado',Number(all[n][10])+1,stamp]]);countDone++;}append_('_Mantenimiento',[[job,mode,JSON.stringify(scope),stamp,'Completado']]);}
 if(mode==='documents'){for(const d of docs){try{const match=String(d[4]).match(/\/d\/([a-zA-Z0-9_-]+)/);if(!match)throw Error('Enlace no reconocido');DriveApp.getFileById(match[1]).setTrashed(true);countDone++;}catch(e){issues.push(String(d[2])+': '+e.message);}}append_('_Mantenimiento',[[job,mode,JSON.stringify(scope),stamp,issues.length?'Parcial':'Completado']]);}
 if(mode==='factory'){const sheet=book_().getSheetByName('Configuracion');if(sheet.getLastRow()>1)sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).clearContent();const p=ensureSheet_('Perfiles',['ID','Nombre','Funciones JSON']);if(p.getLastRow()>1)p.getRange(2,1,p.getLastRow()-1,3).clearContent();append_('Perfiles',defaultProfiles_().map(p=>[p.id,p.name,JSON.stringify(p.functions)]));const users=values_('Usuarios');for(let n=0;n<users.length;n++)if(!['admin','calidad','instalaciones'].includes(users[n][2]))book_().getSheetByName('Usuarios').getRange(n+2,4).setValue('No');PropertiesService.getScriptProperties().setProperty('FACTORY_EPOCH',String(+stamp));countDone=count;append_('_Mantenimiento',[[job,mode,'{}',stamp,'Completado']]);}

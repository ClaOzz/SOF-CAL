function defaultProfiles_(){const all=[...Object.keys(SOF_SECTIONS).filter(k=>k!=='sensibilizacion'),'documentos'];return [{id:'admin',name:'Administrador',functions:all},{id:'calidad',name:'Calidad',functions:all},{id:'instalaciones',name:'Instalaciones',functions:['liberacion','iat','sat','rayado','documentos']}];}
function profiles_(){const rows=values_('Perfiles');return rows.length?rows.map(r=>({id:String(r[0]),name:String(r[1]),functions:JSON.parse(r[2]||'[]')})):defaultProfiles_();}
function capabilities_(role){if(role==='admin')return defaultProfiles_()[0].functions;return profiles_().find(p=>p.id===role)?.functions||[];}
function configValue_(key,fallback){const row=values_('Configuracion').find(r=>r[0]===key);if(!row)return fallback;let v=JSON.parse(row[1]);if(v?.driveFile)v=JSON.parse(DriveApp.getFileById(v.driveFile).getBlob().getDataAsString());return v;}
function expectedProject_(r){const cat=configValue_('catalog',null),map=Object.assign({},SOF_PROJECTS);for(const s of cat?.systems||[])if(s.cod&&s.proy)map[s.cod]=String(s.proy).match(/D\d{3}/)?.[0]||'';const m=meta_(r);if(m.system==='MAT'){const codes=r.subs||[];const projects=[...new Set(codes.map(c=>map[c]).filter(Boolean))];return projects.length===1?projects[0]:'';}return map[m.system]||'';}
function assignProject_(r){const m=meta_(r),old=recordRow_(m.id);if(old)return;const project=expectedProject_(r);if(!project)throw Error('PROYECTO: el administrador debe asignar el proyecto de este sistema en Ajustes.');if(r.uuid)r.datos.proyecto=project;else r.project=project;}
function validateMaintenance_(r){const m=meta_(r);for(const row of values_('_Mantenimiento')){if(row[1]!=='records'||row[4]!=='Completado')continue;const f=JSON.parse(row[2]||'{}'),cutoff=new Date(row[3]).getTime(),created=new Date(r.created||r.date||r.datos?.fecha||0).getTime();if((!f.project||f.project===m.project)&&(!f.kind||f.kind===m.kind)&&created&&created<=cutoff)throw Error('ELIMINADO: la administración retiró los registros de este alcance. Cree una captura nueva.');}}
function admin_(u,req){adminOnly_(u);const op=req.op||'read';if(op==='read')return {users:values_('Usuarios').map(r=>({email:r[0],name:r[1],role:r[2],active:['SI','SÍ','TRUE','1'].includes(String(r[3]).toUpperCase()),tri:r[4]})),profiles:profiles_(),functions:[...Object.keys(SOF_SECTIONS),'documentos'],serverVersion:'4.0'};
 if(op==='user'){const x=req.user||{},email=String(x.email||'').trim().toLowerCase();if(!/^[^\s@]+@gmail\.com$/.test(email)||!String(x.name||'').trim()||!profiles_().some(p=>p.id===x.role))throw Error('Revise Gmail, nombre y perfil.');if(x.tri&&!/^[A-ZÑ]{3}$/.test(String(x.tri).toUpperCase()))throw Error('Trigrama: tres letras.');const rows=values_('Usuarios'),idx=rows.findIndex(r=>String(r[0]).trim().toLowerCase()===email);const active=x.active===true;if(email===u.email&&(!active||x.role!=='admin'))throw Error('No puede desactivar ni retirar su propio acceso de administrador.');if(idx>=0&&rows[idx][2]==='admin'&&(!active||x.role!=='admin')&&!rows.some((r,n)=>n!==idx&&r[2]==='admin'&&['SI','SÍ','TRUE','1'].includes(String(r[3]).toUpperCase())))throw Error('Debe permanecer al menos un administrador activo.');const row=[email,String(x.name).trim(),x.role,active?'Sí':'No',String(x.tri||'').toUpperCase(),idx>=0?rows[idx][5]:''];if(idx<0)append_('Usuarios',[row]);else book_().getSheetByName('Usuarios').getRange(idx+2,1,1,6).setValues([row.map(safe_)]);append_('Auditoria',[[new Date(),u.email,'EDITAR_USUARIO',email,x.role,'']]);return {saved:true};}

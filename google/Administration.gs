 throw Error('Operación administrativa no admitida.');}
function maintenanceRows_(scope){return values_('Registros').filter(r=>r[9]!=='Eliminado'&&(!scope.project||r[4]===scope.project)&&(!scope.kind||r[1]===scope.kind));}
function maintenance_(u,req){adminOnly_(u);const mode=req.mode,scope=req.scope||{};if(!['records','documents','factory'].includes(mode))throw Error('Operación no válida.');if(scope.project&&!/^D\d{3}$/.test(scope.project)||scope.kind&&!Object.hasOwn(SOF_SECTIONS,scope.kind))throw Error('Alcance inválido.');const rows=maintenanceRows_(scope);const documentIDs=new Set(values_('Registros').filter(r=>(!scope.project||r[4]===scope.project)&&(!scope.kind||r[1]===scope.kind)).map(r=>r[0]));const docs=values_('Documentos').filter(r=>documentIDs.has(r[0]));const payload=mode==='documents'?docs.map(r=>[r[0],r[4]]):mode==='records'?rows.map(r=>[r[0],r[10]]):values_('Configuracion').map(r=>[r[0],r[2]]).concat(values_('Perfiles'));
